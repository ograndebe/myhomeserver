# =============================================================================
# Gerado pelo build.sh — não edite manualmente após o build
# =============================================================================

# --- Rede ---
DOMAIN={{DOMAIN}}
SERVER_IP={{SERVER_IP}}

# --- Diretório de dados (volumes) ---
# Todos os dados persistentes ficam aqui — faça backup deste diretório
DATA_DIR={{DATA_DIR}}

# --- Traefik ---
TRAEFIK_DASHBOARD_USER={{TRAEFIK_DASHBOARD_USER}}
TRAEFIK_DASHBOARD_PASSWORD_HASH={{TRAEFIK_DASHBOARD_PASSWORD_HASH}}

# --- Let's Encrypt / Cloudflare DNS Challenge ---
ACME_EMAIL={{ACME_EMAIL}}
CF_DNS_API_TOKEN={{CF_DNS_API_TOKEN}}

# --- AdGuard Home ---
ADGUARD_ADMIN_PASSWORD={{ADGUARD_ADMIN_PASSWORD}}

# --- WireGuard ---
WIREGUARD_PEER_COUNT=5
