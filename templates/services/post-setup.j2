  # ── Post-Setup (bootstrap automatizado da stack *arr) ────────────────────
  post-setup:
    image: python:3.12-slim
    container_name: homeserver-post-setup
    restart: "no"
    environment:
      - DOMAIN={{ domain }}
      - AUTHENTIK_URL=http://authentik-server:9000
      - AUTHENTIK_INITIAL_ADMIN_EMAIL={{ authentik_email }}
      - AUTHENTIK_INITIAL_ADMIN_PASSWORD={{ authentik_password }}
      - STORAGE_PATH={{ storage_path }}
    volumes:
      - {{ root_path }}/scripts/post_setup.py:/app/post_setup.py:ro
      - {{ root_path }}/output/.env:/app/.env:ro
      - {{ root_path }}/trackers.txt:/app/trackers.txt:ro
      - {{ storage_path }}/prowlarr/config:/prowlarr-config:ro
      - {{ storage_path }}/radarr/config:/radarr-config:ro
      - {{ storage_path }}/sonarr/config:/sonarr-config:ro
      - {{ storage_path }}/lidarr/config:/lidarr-config:ro
      - {{ storage_path }}/bazarr/config:/bazarr-config:ro
      - {{ storage_path }}/qbittorrent/config:/qbittorrent-config:ro
      - {{ storage_path }}/jellyfin/config:/jellyfin-config:ro
      - {{ storage_path }}/jellyseerr/config:/jellyseerr-config:ro
    networks:
      - proxy
      - internal
    depends_on:
      authentik-server:
        condition: service_healthy
      jellyfin:
        condition: service_healthy
      prowlarr:
        condition: service_healthy
      radarr:
        condition: service_healthy
      sonarr:
        condition: service_healthy
      lidarr:
        condition: service_healthy
      bazarr:
        condition: service_healthy
      qbittorrent:
        condition: service_healthy
      jellyseerr:
        condition: service_healthy
    command: ["sh", "-c", "pip install --quiet requests python-dotenv rich && python3 /app/post_setup.py"]
